{
  "name": "ordo-community",
  "version": "0.4.0",
  "private": true,
  "description": "Ordo Community Edition – Buchhaltung, Projekte und Lager an einem Ort. Lokal, verschlüsselt, für Österreich.",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ordo/app dev",
    "build": "pnpm -r build",
    "build:app": "pnpm --filter @ordo/app build",
    "build:core": "pnpm --filter @ordo/core build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "desktop": "pnpm --filter @ordo/desktop tauri dev",
    "desktop:build": "pnpm --filter @ordo/desktop tauri build",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "AGPL-3.0-only"
}
